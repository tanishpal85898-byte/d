# CivicConnect Configuration

# ==========================================
# 1. Google Gemini AI API (ONE API Only)
# ==========================================
# Single API generates: category, summary, severity
# If empty or omitted, CivicConnect runs in resilient offline fallback mode
VITE_GEMINI_API_KEY=

# ==========================================
# 2. Firebase Configuration (Optional)
# ==========================================
# If left blank, CivicConnect automatically operates in Hackathon Demo Mode
# with realistic mock seed data and simulated local persistence.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
